<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detail Soal - SMA Nusantara</title>
  <link rel="stylesheet" href="/css/detail-soal.css">
  <link rel="stylesheet" href="/css/cursor.css">
</head>
<body>
  <div class="ds-wrapper">
    <a href="/profile-guru" class="ds-back">&larr; Kembali ke Profile</a>

    <!-- ================= INFO SOAL ================= -->
    <div class="ds-card-info">
      <span class="ds-label">Detail Soal</span>
      <h1 class="ds-judul"><%= soal.judul %></h1>
      <p class="ds-deskripsi"><%= soal.deskripsi %></p>

      <div class="ds-meta">
        <div class="ds-meta-item"><strong>Jumlah Soal:</strong> <%= jumlah_soal %></div>
      </div>
    </div>

    <!-- ================= MURID YANG MENGERJAKAN ================= -->
    <div class="ds-section">
      <div class="ds-section-header">
        <h2>Murid yang Sudah Mengerjakan</h2>
      </div>

      <div class="ds-table-wrapper">
        <table class="ds-table">
          <thead>
            <tr>
              <th>Nama Murid</th>
              <th>NISN</th>
              <th>Nilai</th>
              <th>Keluar Tab</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (hasilSoal && hasilSoal.length > 0) { %>
              <% hasilSoal.forEach(function(h){
                  const siswa = h.id_siswa;
              %>
                <tr>
                  <td><%= siswa ? siswa.name : '-' %></td>
                  <td><%= siswa ? siswa.nisn : '-' %></td>
                  <td class="ds-nilai <%= h.nilai >= 70 ? 'baik' : 'kurang' %>"><%= h.nilai %></td>
                  <td>
                    <% if (h.keluarTab) { %>
                      <span class="ds-badge-warning">Keluar tab (<%= h.jumlahKeluarTab %>x)</span>
                    <% } else { %>
                      <span class="ds-badge-ok">Tidak keluar</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (h.ditutupPaksa) { %>
                      <span class="ds-badge-danger">
                        Tab ditutup paksa
                        <% if (h.waktuDitutupPaksa) { %>
                          (<%= new Date(h.waktuDitutupPaksa).toLocaleString('id-ID') %>)
                        <% } %>
                      </span>
                    <% } else { %>
                      <span class="ds-badge-ok">Selesai normal</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
        <% if (!hasilSoal || hasilSoal.length === 0) { %>
          <p class="ds-empty">Belum ada murid yang mengerjakan soal ini.</p>
        <% } %>
      </div>
    </div>
  </div>

  <script src="/js/cursor.js"></script>
</body>
</html>