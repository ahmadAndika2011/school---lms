<!-- ================= NAVBAR ================= -->
<header class="navbar" id="navbar">
  <div class="container navbar__inner">
    <a href="/" class="navbar__brand">
      <img src="/img/logo.png" alt="Logo Sekolah" class="navbar__logo" />
      <p class="navbar__title">SMA Nusantara</p>
    </a>

    <nav class="navbar__menu" id="navMenu">
      <a href="/">Beranda</a>
      <a href="#kontak" class="navbar__cta">Hubungi Kami</a>

      <% if(user == null) {%>
        <a href="/signup" class="navbar__link navbar__link--masuk">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                <polyline points="10 17 15 12 10 7"></polyline>
                <line x1="15" y1="12" x2="3" y2="12"></line>
              </svg>
              <span>Sign-up</span>
          </a>

          <a href="/login" class="navbar__link navbar__link--login">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <span>Login</span>
          </a>
        <% } else { %>
          <a href="/profile" class="navbar__link navbar__link--profile">
            <% if (user.gambar) { %>
              <img src="<%= user.gambar %>" alt="Foto profil <%= user.name %>" class="navbar__avatar" />
            <% } else { %>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            <% } %>
          </a>
        <% } %>
    </nav>

    <button
      class="navbar__burger"
      id="navBurger"
      aria-label="Buka menu"
      type="button"
    >
      <i class="bar"></i>
      <i class="bar"></i>
      <i class="bar"></i>
    </button>
  </div>
</header>