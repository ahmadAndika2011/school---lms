<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile Guru - SMA Nusantara</title>
  <link rel="stylesheet" href="/css/profile-guru.css">
  <style>
    :root {
      --hijau-tua: #0d5c3f;
      --hijau-muda: #e8f3ec;
      --kuning: #f5c518;
      --teks-gelap: #1a1a1a;
      --abu: #6b7280;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: 'Segoe UI', Arial, sans-serif;
      background-color: #ffffff;
      color: var(--teks-gelap);
    }

    .guru-wrapper {
      max-width: 900px;
      margin: 60px auto;
      padding: 0 20px;
    }

    .guru-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--hijau-tua);
      text-decoration: none;
      font-weight: 600;
      margin-bottom: 30px;
    }

    .guru-back:hover { text-decoration: underline; }

    .guru-card {
      display: flex;
      gap: 40px;
      background: var(--hijau-muda);
      border-radius: 16px;
      padding: 40px;
      position: relative;
      overflow: hidden;
    }

    .guru-card::before {
      content: "";
      position: absolute;
      top: -40px;
      right: -40px;
      width: 120px;
      height: 120px;
      background: var(--kuning);
      border-radius: 50%;
      opacity: 0.9;
    }

    .guru-foto {
      flex-shrink: 0;
      width: 220px;
      height: 260px;
      border-radius: 12px;
      overflow: hidden;
      background: #d9d9d9;
      box-shadow: 0 8px 20px rgba(13, 92, 63, 0.2);
      z-index: 1;
    }

    .guru-foto img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .guru-info {
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .guru-label {
      color: var(--hijau-tua);
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      font-size: 13px;
      margin-bottom: 8px;
    }

    .guru-nama {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 32px;
      font-weight: 700;
      color: var(--teks-gelap);
      margin: 0 0 6px 0;
    }

    .guru-mapel {
      color: var(--hijau-tua);
      font-weight: 600;
      font-size: 16px;
      margin-bottom: 16px;
    }

    .guru-meta {
      display: flex;
      gap: 20px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }

    .guru-meta-item {
      background: #ffffff;
      border-radius: 8px;
      padding: 8px 14px;
      font-size: 14px;
      color: var(--abu);
    }

    .guru-meta-item strong {
      color: var(--teks-gelap);
    }

    .guru-deskripsi {
      color: #333;
      line-height: 1.7;
      font-size: 15px;
      max-width: 500px;
    }

    @media (max-width: 640px) {
      .guru-card {
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 30px 20px;
      }
      .guru-info { align-items: center; }
      .guru-meta { justify-content: center; }
    }

    /* ================= SOAL SECTION ================= */
    .soal-section {
      margin-top: 50px;
    }

    .soal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .soal-header h2 {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 22px;
      color: var(--teks-gelap);
      margin: 0;
    }

    .btn-tambah-soal {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--hijau-tua);
      color: #ffffff;
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
      padding: 10px 20px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .btn-tambah-soal:hover {
      background: #0a4a32;
    }

    .btn-tambah-soal::before {
      content: "+";
      font-size: 16px;
      font-weight: 700;
    }

    .soal-table-wrapper {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      overflow: hidden;
    }

    .soal-table {
      width: 100%;
      border-collapse: collapse;
    }

    .soal-table thead {
      background: var(--hijau-tua);
    }

    .soal-table thead th {
      color: #ffffff;
      text-align: left;
      font-size: 13px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      padding: 14px 20px;
    }

    .soal-table tbody td {
      padding: 14px 20px;
      font-size: 14px;
      color: var(--teks-gelap);
      border-top: 1px solid #f0f0f0;
    }

    .soal-table tbody tr:hover {
      background: var(--hijau-muda);
    }

    .soal-empty {
      padding: 30px 20px;
      text-align: center;
      color: var(--abu);
      font-size: 14px;
    }
  </style>
</head>
<body>
  <div class="guru-wrapper">
    <a href="/" class="guru-back">&larr; Kembali ke Beranda</a>

    <div class="guru-card">
      <div class="guru-foto">
        <% if (guru.photo) { %>
          <img src="/uploads/gambar-guru/<%= guru.photo %>" alt="Foto <%= guru.nama %>">
        <% } else { %>
          <img src="/img/default-avatar.png" alt="Foto Guru">
        <% } %>
      </div>

      <div class="guru-info">
        <span class="guru-label">Tenaga Pengajar</span>
        <h1 class="guru-nama"><%= guru.nama %></h1>
        <p class="guru-mapel"><%= guru.jabatan %></p>

        <div class="guru-meta">
          <div class="guru-meta-item"><strong>NIP:</strong> <%= guru.nip %></div>
          <div class="guru-meta-item"><strong>Jenis Kelamin:</strong> <%= guru.jenis_kelamin %></div>
          <div class="guru-meta-item"><strong>Status:</strong> <%= guru.status %></div>
        </div>
      </div>
    </div>

    <!-- ================= DAFTAR SOAL ================= -->
    <div class="soal-section">
      <div class="soal-header">
        <h2>Daftar Soal</h2>
        <a href="/tambah-soal" class="btn-tambah-soal">Tambah Soal</a>
      </div>

      <div class="soal-table-wrapper">
        <%
          // DATA DUMMY - ganti dengan data asli dari database nanti
          const soal = [
            { id_soal: "SOAL001", judul_soal: "Ulangan Harian Matematika Bab 1" },
            { id_soal: "SOAL002", judul_soal: "Kuis Aljabar Linear" },
            { id_soal: "SOAL003", judul_soal: "Latihan Soal Trigonometri" },
            { id_soal: "SOAL004", judul_soal: "Ujian Tengah Semester Ganjil" }
          ];
        %>
        <table class="soal-table">
          <thead>
            <tr>
              <th>ID Soal</th>
              <th>Judul Soal</th>
            </tr>
          </thead>
          <tbody>
            <% if (soal && soal.length > 0) { %>
              <% soal.forEach(function(s){ %>
                <tr>
                  <td><%= s.id_soal %></td>
                  <td><%= s.judul_soal %></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
        <% if (!soal || soal.length === 0) { %>
          <p class="soal-empty">Belum ada soal yang ditambahkan.</p>
        <% } %>
      </div>
    </div>
  </div>

</body>
</html>