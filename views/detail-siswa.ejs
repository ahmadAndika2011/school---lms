<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Detail Siswa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/detail-siswa.css" />
    <link rel="stylesheet" href="/css/cursor.css" />
  </head>

  <body>
    <div class="profile-page">
      <div class="profile-card">

        <a href="/siswa" class="profile-back">&larr; Kembali ke Daftar Siswa</a>

        <!-- Banner + foto -->
        <div class="profile-banner">
          <div class="profile-photo">
            <% if (siswa.gambar) { %>
              <img
                src="/uploads/gambar-siswa<%= siswa.gambar %>"
                alt="Foto profil <%= siswa.name %>"
              />
            <% } else { %>
              <span class="profile-photo-fallback"><%= siswa.name ? siswa.name.charAt(0) : "?" %></span>
            <% } %>
          </div>
        </div>

        <div class="profile-body">
          <h1 class="profile-nama"><%= siswa.name %></h1>
          <p class="profile-email"><%= siswa.email %></p>

          <div class="profile-details">
            <div class="detail-row">
              <span class="detail-label">Jenis Kelamin</span>
              <span class="detail-leader"></span>
              <span class="detail-value"><%= siswa.jenis_kelamin %></span>
            </div>

            <div class="detail-row">
              <span class="detail-label">NISN</span>
              <span class="detail-leader"></span>
              <span class="detail-value"><%= siswa.nisn %></span>
            </div>

            <div class="detail-row">
              <span class="detail-label">Tempat Lahir</span>
              <span class="detail-leader"></span>
              <span class="detail-value"><%= siswa.tempat_lahir %></span>
            </div>

            <div class="detail-row">
              <span class="detail-label">Tanggal Lahir</span>
              <span class="detail-leader"></span>
              <span class="detail-value">
                <% if (siswa.tanggal_lahir) { %>
                  <%= new Date(siswa.tanggal_lahir).toLocaleDateString("id-ID", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                  }) %>
                <% } else { %>
                  -
                <% } %>
              </span>
            </div>
          </div>

          <!-- Data Nilai -->
          <div class="profile-nilai">
            <h2>Data Nilai</h2>

            <% if (typeof hasilSoal !== "undefined" && hasilSoal && hasilSoal.length > 0) { %>
            <div class="nilai-table-wrap">
              <table class="nilai-table">
                <thead>
                  <tr>
                    <th>Judul Soal</th>
                    <th>ID Guru</th>
                    <th>ID Soal</th>
                    <th>Nilai</th>
                  </tr>
                </thead>
                <tbody>
                  <% hasilSoal.forEach(function(hasil) {
                       const soal = hasil.id_soal;
                       const nilai = hasil.nilai;
                       const nilaiClass = nilai >= 75 ? "nilai-tinggi" : (nilai >= 50 ? "nilai-sedang" : "nilai-rendah");
                  %>
                  <tr>
                    <td><%= soal ? soal.judul : '-' %></td>
                    <td class="id-cell" title="<%= soal ? soal.id_guru : '' %>">
                      <%= soal ? String(soal.id_guru).slice(-6) : '-' %>
                    </td>
                    <td class="id-cell" title="<%= soal ? soal._id : hasil.id_soal %>">
                      <%= soal ? String(soal._id).slice(-6) : String(hasil.id_soal).slice(-6) %>
                    </td>
                    <td>
                      <span class="nilai-chip <%= nilaiClass %>"><%= nilai %></span>
                    </td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
            <% } else { %>
            <p class="empty-state">Belum ada data nilai.</p>
            <% } %>
          </div>

        </div>
      </div>
    </div>

    <script src="/js/cursor.js"></script>
  </body>
</html>