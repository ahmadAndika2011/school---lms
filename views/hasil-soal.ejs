<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hasil Soal - SMA Nusantara</title>
  <link rel="stylesheet" href="/css/cursor.css">
  <link rel="stylesheet" href="/css/hasil-soal.css">
</head>
<body>
  <div class="hs-wrapper">
    <a href="/soal" class="hs-back">&larr; Kembali ke Daftar Soal</a>

    <!-- ================= CARD SISWA ================= -->
    <div class="hs-card-siswa">
      <div class="hs-foto">
        <img src="<%= siswa.gambar %>" alt="Foto <%= siswa.name %>">
      </div>

      <div class="hs-info">
        <span class="hs-label">Peserta</span>
        <h1 class="hs-nama"><%= siswa.name %></h1>

        <div class="hs-meta">
          <div class="hs-meta-item"><strong>NISN:</strong> <%= siswa.nisn %></div>
          <div class="hs-meta-item"><strong>Jenis Kelamin:</strong> <%= siswa.jenis_kelamin %></div>
          <div class="hs-meta-item"><strong>TTL:</strong> <%= siswa.tempat_lahir %>, <%= siswa.tanggal_lahir.toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" }) %></div>
          <div class="hs-meta-item"><strong>Email:</strong> <%= siswa.email %></div>
        </div>
      </div>
    </div>

    <!-- ================= CARD HASIL ================= -->
    <div class="hs-card-hasil">
      <h2>Hasil Pengerjaan</h2>
      <p class="hs-judul-soal"><%= soal.judul %></p>

      <div class="hs-nilai-lingkaran <%= hasil.nilai < 70 ? 'kurang' : '' %>">
        <span class="hs-nilai-angka"><%= hasil.nilai %></span>
        <span class="hs-nilai-label">/ 100</span>
      </div>

      <span class="hs-status <%= hasil.nilai < 70 ? 'kurang' : '' %>">
        <%= hasil.nilai < 70 ? 'Belum Lulus' : 'Lulus' %>
      </span>
    </div>

    <!-- ================= RINCIAN JAWABAN ================= -->
    <div class="hs-card-detail">
      <h2>Rincian Jawaban</h2>

      <div class="hs-detail-list">
        <% soal.soal.forEach(function (pertanyaan, index) { %>
          <%
            const jawabanSiswa = hasil.jawaban.find(function (j) {
              return j.id_pertanyaan.toString() === pertanyaan._id.toString()
            })
            const sudahBenar = jawabanSiswa && jawabanSiswa.benar
          %>
          <div class="hs-detail-item <%= sudahBenar ? 'benar' : 'salah' %>">
            <span class="hs-detail-nomor"><%= index + 1 %></span>

            <div class="hs-detail-body">
              <p class="hs-detail-pertanyaan"><%= pertanyaan.pertanyaan %></p>
              <p class="hs-detail-jawaban">
                Jawaban kamu:
                <strong>
                  <%= jawabanSiswa && jawabanSiswa.jawaban_dipilih ? jawabanSiswa.jawaban_dipilih.toUpperCase() : "Tidak dijawab" %>
                </strong>
                <% if (!sudahBenar) { %>
                  &middot; Jawaban benar: <strong><%= pertanyaan.jawaban_benar.toUpperCase() %></strong>
                <% } %>
              </p>
            </div>

            <span class="hs-detail-icon"><%= sudahBenar ? "&#10003;" : "&#10005;" %></span>
          </div>
        <% }); %>
      </div>
    </div>
  </div>

  <script src="/js/cursor.js"></script>
</body>
</html>