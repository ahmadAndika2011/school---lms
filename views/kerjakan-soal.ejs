<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kerjakan Soal - SMA Nusantara</title>
  <link rel="stylesheet" href="/css/cursor.css">
  <link rel="stylesheet" href="/css/kerjakan-soal.css">
</head>
<body>
  <div class="ks-wrapper">

    <!-- ================= HEADER ================= -->
    <div class="ks-header">
      <span class="ks-header-label">Sedang Mengerjakan</span>
      <h1><%= soal.judul %></h1>
      <p><%= soal.deskripsi %></p>

      <div class="ks-progress-track">
        <div class="ks-progress-fill" id="ks-progress-fill"></div>
      </div>
      <span class="ks-progress-label" id="ks-progress-label">0 dari <%= soal.soal.length %> soal terjawab</span>
    </div>

    <!-- ================= FORM SOAL ================= -->
    <form id="form-kerjakan-soal" action="/kerjakan-soal/<%= soal._id %>" method="POST">
      <div class="ks-soal-list">
        <% soal.soal.forEach(function (item, index) { %>
          <div class="ks-card">
            <span class="ks-nomor"><%= index + 1 %></span>
            <p class="ks-pertanyaan"><%= item.pertanyaan %></p>

            <% if (item.gambar && item.gambar.length > 0) { %>
              <div class="ks-gambar-list">
                <% item.gambar.forEach(function (g) { %>
                  <img src="/uploads/gambar-soal/<%= g %>" alt="Gambar soal <%= index + 1 %>">
                <% }); %>
              </div>
            <% } %>

            <div class="ks-pilihan-list">
              <% item.jawaban.forEach(function (opsi) { %>
                <label class="ks-pilihan-item">
                  <input
                    type="radio"
                    name="jawaban[<%= item._id %>]"
                    value="<%= opsi.pilihan %>"
                    required
                  >
                  <span class="ks-pilihan-huruf"><%= opsi.pilihan %></span>
                  <span class="ks-pilihan-teks"><%= opsi.text %></span>
                </label>
              <% }); %>
            </div>
          </div>
        <% }); %>
      </div>

      <div class="ks-submit-row">
        <button type="submit" class="ks-btn-submit">Selesai &amp; Kumpulkan</button>
      </div>
    </form>
  </div>

  <script>
      const form = document.getElementById("form-kerjakan-soal");
      const totalSoal = <%= soal.soal.length %>;
      const progressFill = document.getElementById("ks-progress-fill");
      const progressLabel = document.getElementById("ks-progress-label");
      const submitBtn = form.querySelector(".ks-btn-submit");

      let mediaRecorder;
      let recordedChunks = [];
      let screenStream;
      let rekamanAktif = false;

      // === DETEKSI KELUAR TAB (pindah tab / minimize) ===
      let jumlahKeluarTab = 0;

      document.addEventListener("visibilitychange", () => {
        if (document.hidden && rekamanAktif) {
          jumlahKeluarTab++;
        }
      });

      // === PROGRESS BAR ===
      function updateProgress() {
        const namaTerjawab = new Set();
        form.querySelectorAll('input[type="radio"]:checked').forEach(function (input) {
          namaTerjawab.add(input.name);
        });
        const jumlah = namaTerjawab.size;
        const persen = totalSoal > 0 ? (jumlah / totalSoal) * 100 : 0;
        progressFill.style.width = persen + "%";
        progressLabel.textContent = jumlah + " dari " + totalSoal + " soal terjawab";
      }

      form.addEventListener("change", updateProgress);

      // === PEREKAMAN LAYAR ===
      async function mintaIzinRekamLayar() {
        try {
          screenStream = await navigator.mediaDevices.getDisplayMedia({ video: true, audio: false });
        } catch (err) {
          alert("Anda harus mengizinkan perekaman layar untuk mengerjakan soal ini. Halaman akan dimuat ulang.");
          window.location.reload();
          return;
        }

        mediaRecorder = new MediaRecorder(screenStream, { mimeType: "video/webm;codecs=vp9" });
        recordedChunks = [];

        mediaRecorder.ondataavailable = (e) => {
          if (e.data.size > 0) recordedChunks.push(e.data);
        };

        mediaRecorder.start();
        rekamanAktif = true;

        // Jika siswa mematikan share layar secara manual di tengah pengerjaan
        screenStream.getVideoTracks()[0].addEventListener("ended", () => {
          rekamanAktif = false;
          submitBtn.disabled = true;
          alert("Perekaman layar berhenti. Anda tidak bisa mengumpulkan jawaban sebelum menyalakan ulang perekaman layar.");
        });
      }

      function stopRekamanDanAmbilBlob() {
        return new Promise((resolve) => {
          mediaRecorder.onstop = () => {
            const blob = new Blob(recordedChunks, { type: "video/webm" });
            resolve(blob);
          };
          screenStream.getTracks().forEach((track) => track.stop());
          mediaRecorder.stop();
        });
      }

      // === SUBMIT FORM ===
      form.addEventListener("submit", async function (e) {
        e.preventDefault();

        const namaTerjawab = new Set();
        form.querySelectorAll('input[type="radio"]:checked').forEach(function (input) {
          namaTerjawab.add(input.name);
        });
        if (namaTerjawab.size < totalSoal) {
          alert("Masih ada soal yang belum dijawab. Pastikan semua soal sudah diisi sebelum mengumpulkan.");
          return;
        }

        if (!rekamanAktif) {
          alert("Perekaman layar tidak aktif. Nyalakan ulang perekaman sebelum mengumpulkan jawaban.");
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = "Menyimpan...";

        try {
          const videoBlob = await stopRekamanDanAmbilBlob();

          const formData = new FormData(form);
          formData.append("video", videoBlob, `rekaman-${Date.now()}.webm`);
          formData.append("jumlahKeluarTab", jumlahKeluarTab);
          formData.append("keluarTab", jumlahKeluarTab > 0 ? "true" : "false");

          const res = await fetch(form.action, {
            method: "POST",
            body: formData
          });

          if (!res.ok) throw new Error("Gagal mengirim data");

          const data = await res.json();
          window.location.href = data.redirectUrl;
        } catch (err) {
          alert("Terjadi kesalahan saat mengumpulkan jawaban. Silakan coba lagi.");
          submitBtn.disabled = false;
          submitBtn.textContent = "Selesai & Kumpulkan";
        }
      });

      // minta izin rekam layar begitu halaman dibuka
      mintaIzinRekamLayar();
  </script>

  <script src="/js/cursor.js"></script>
</body>
</html>